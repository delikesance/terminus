# Terminus: ZDOTDIR shim so local zsh sessions load the integration after the
# user's own startup files. Restores the real ZDOTDIR first.
if [[ -n ${TERMINUS_ORIG_ZDOTDIR+x} ]]; then
  if [[ -n $TERMINUS_ORIG_ZDOTDIR ]]; then ZDOTDIR=$TERMINUS_ORIG_ZDOTDIR; else unset ZDOTDIR; fi
  unset TERMINUS_ORIG_ZDOTDIR
fi
[[ -f ${ZDOTDIR:-$HOME}/.zshenv ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
if [[ -o interactive && -n $TERMINUS_SHELL_INTEGRATION ]]; then
  __terminus_boot() {
    add-zsh-hook -d precmd __terminus_boot
    unfunction __terminus_boot
    source "$TERMINUS_SHELL_INTEGRATION/terminus.zsh"
    __terminus_precmd
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd __terminus_boot
fi
