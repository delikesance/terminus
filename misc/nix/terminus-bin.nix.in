# Generated by scripts/release.sh — do not edit by hand.
# NixOS install (binary, Linux x86_64):
#   environment.systemPackages = [ (pkgs.callPackage ./terminus.nix { }) ];
{
  lib,
  stdenv,
  fetchurl,
  autoPatchelfHook,
  fontconfig,
  libGL,
  libxkbcommon,
  vulkan-loader,
  krb5,
  libX11,
  libXcursor,
  libXi,
  libXrandr,
  libxcb,
  wayland,
  gcc-unwrapped,
}:
stdenv.mkDerivation rec {
  pname = "terminus";
  version = "@VERSION@";

  src = fetchurl {
    url = "https://github.com/delikesance/terminus/releases/download/v${version}/terminus-linux-x86_64.tar.gz";
    hash = "@TARBALL_HASH@";
  };

  nativeBuildInputs = [autoPatchelfHook];

  buildInputs = [
    (lib.getLib gcc-unwrapped)
    fontconfig
    libGL
    libxkbcommon
    vulkan-loader
    krb5
    libX11
    libXcursor
    libXi
    libXrandr
    libxcb
    wayland
  ];

  # Tarball layout: terminus/{terminus,terminus.desktop,logo.svg,rio.terminfo}
  sourceRoot = "terminus";

  installPhase = ''
    runHook preInstall

    install -Dm755 terminus $out/bin/terminus

    if [[ -f terminus.desktop ]]; then
      install -Dm644 terminus.desktop $out/share/applications/terminus.desktop
    fi
    if [[ -f logo.svg ]]; then
      install -Dm644 logo.svg $out/share/icons/hicolor/scalable/apps/terminus.svg
    fi

    runHook postInstall
  '';

  meta = {
    description = "Hardware-accelerated GPU terminal emulator";
    homepage = "https://github.com/delikesance/terminus";
    license = lib.licenses.mit;
    platforms = ["x86_64-linux"];
    mainProgram = "terminus";
    sourceProvenance = with lib.sourceTypes; [binaryNativeCode];
  };
}
