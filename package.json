{
  "name": "terminus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "selftest": "cargo run -p terminus-core --bin terminus-selftest && npm run test:search-ux && npm run test:group-softdelete",
    "test:search-ux": "node src/groupExpand.test.js",
    "test:group-softdelete": "npm run compile:test-groupsoftdelete && node src/groupSoftDelete.test.js",
    "compile:test-groupsoftdelete": "npx tsc --module esnext --target es2022 --moduleResolution bundler --outDir src src/groupSoftDelete.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
